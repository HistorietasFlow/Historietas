# INERTE: nao aplicar antes da aprovacao operacional documentada.
# Watchdog: cadencia aprovada de 15 minutos UTC; ativacao AINDA NAO autorizada.
# Monitor SQL: proposta de 15 min, cinco minutos antes; depende de aprovacao.
# Janela SQL proposta: 30 min, sem default no codigo. Nao aplicar nesta fase.
# Ver sentry-watchdog-homologacao.md para pre-requisitos e selecao do watchdog.
# Mesmo em workflows separados, falha conjunta do Actions exige testemunha externa.
diff --git a/.github/workflows/agendamento-monitor.yml b/.github/workflows/agendamento-monitor.yml
--- a/.github/workflows/agendamento-monitor.yml
+++ b/.github/workflows/agendamento-monitor.yml
@@ -3,2 +3,4 @@
 on:
+  schedule:
+    - cron: '10,25,40,55 * * * *'
   workflow_dispatch:
diff --git a/.github/workflows/agendamento-watchdog.yml b/.github/workflows/agendamento-watchdog.yml
--- a/.github/workflows/agendamento-watchdog.yml
+++ b/.github/workflows/agendamento-watchdog.yml
@@ -3,2 +3,4 @@
 on:
+  schedule:
+    - cron: '*/15 * * * *'
   workflow_dispatch:
