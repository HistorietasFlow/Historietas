{
  "name": "historietas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:static": "node qa/scripts/static-audit.mjs",
    "test:pagination": "node --test qa/unit/paginacao-alto-volume.test.mjs",
    "test:pagination:integration": "node --test qa/integration/paginacao-supabase-real.test.mjs",
    "test:smoke": "node qa/scripts/http-smoke.mjs",
    "test:e2e": "npm --prefix qa install && npm --prefix qa run install:browsers && npm --prefix qa test",
    "test:e2e:headed": "npm --prefix qa install && npm --prefix qa run install:browsers && npm --prefix qa run test:headed",
    "test:e2e:report": "npm --prefix qa run report",
    "test:all": "npm run test:static && npm run test:pagination && npm run typecheck && npm run lint && npm run test:smoke && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
